gun=Sound('cmu://733213/25842887/desert-eagle-gunshot-14622.mp3')
ya=Sound('cmu://733213/25655990/LITTLER.mp3')
Rect(0,0,400,400,fill=gradient('mediumseagreen','green',start='center'))
D2=Group(Oval(200,200,40,100,fill='white',border='red'),Oval(200,200,20,50,fill=None,border='red'))
D1=Oval(200,200,5,10,fill='red')
Sight=Line(200,401,401,401,fill='coral',visible=False)
TimerLabel=Label('Set Timer',70,30,size=25,fill='white',bold=True)
ScoreLabel=Label(0,350,30,size=30,fill='white')
EasyLabel=Group(Rect(120,40,160,80,fill='chartreuse',border='red',borderWidth=10,opacity=50),Label('Easy',200,80,size=30,fill='green'))
MidLabel=Group(Rect(120,160,160,80,fill='blue',border='red',borderWidth=10,opacity=50),Label('Medium',200,200,size=25,fill='white'))
HardLabel=Group(Rect(120,280,160,80,fill='red',border='red',borderWidth=10,opacity=50),Label('Hard',200,320,size=30,fill='red'))
SuperLabel=Label('Impressive!',200,280,size=30,bold=True,visible=False)

D2.visible=False
D1.visible=False
brick=100
wood=0
counter=0
grout=1000
Timer=10
ca=False
cal=45

app.stepsPerSecond=30

def onMouseMove(mouseX,mouseY):
    if counter==0:
        if EasyLabel.contains(mouseX,mouseY):
            EasyLabel.opacity=100
        elif MidLabel.contains(mouseX,mouseY):
            MidLabel.opacity=100
        elif HardLabel.contains(mouseX,mouseY):
            HardLabel.opacity=100
        else:
            EasyLabel.opacity=50
            HardLabel.opacity=50
            MidLabel.opacity=50
    Sight.x2=mouseX
    Sight.y2=mouseY
def onMousePress(mouseX,mouseY):
    global counter,grout,ca
    gun.play(loop=False)
    if counter==0:
        if TimerLabel.contains(mouseX,mouseY):
            TimerLabel.value=45
            ca=True
        if EasyLabel.contains(mouseX,mouseY):
            grout=180
            counter=1
            EasyLabel.visible=False
            MidLabel.visible=False
            HardLabel.visible=False
        elif MidLabel.contains(mouseX,mouseY):
            grout=100
            counter=1
            EasyLabel.visible=False
            MidLabel.visible=False
            HardLabel.visible=False
        elif HardLabel.contains(mouseX,mouseY):
            grout=15
            counter=1
            EasyLabel.visible=False
            MidLabel.visible=False
            HardLabel.visible=False
    if counter==1:
        if D2.contains(mouseX,mouseY) and Sight.steps==32:
                ScoreLabel.value=ScoreLabel.value+20*abs(mouseY-399)
                                                #Here^
                Sight.steps=0
        if D1.contains(mouseX,mouseY) and Sight.steps==32:
            ScoreLabel.value=ScoreLabel.value+50*abs(mouseY-399)
                                             #Here^
            ya.play(loop=False)
            pass
    pass

D1.steps=0
Sight.steps=32
def onStep():
    global brick, wood,counter,cal
    if Sight.steps!=32:
        Sight.steps+=1
    if counter==1:
        D1.steps+=1
        D1.visible=True
        D2.visible=True
        if ca==True:
            #Here V
            cal=cal-0.03
            TimerLabel.value=rounded(cal)
                            #Here^
        else:
            TimerLabel.visible=False
        Sight.visible=True
        if D1.steps%grout==0:
            brick=randrange(0,100)
            wood=randrange(0,100)
        if brick>30:
            D2.centerX=D2.centerX
        elif brick>15:
            D2.centerX=D2.centerX+2
            D1.centerX=D2.centerX  
        else:
            D2.centerX=D2.centerX-2
            D1.centerX=D2.centerX
        if D2.centerX>400:
            brick=14
        elif D2.centerX<0:
            brick=16
        if wood>50:
            D2.centerY=D2.centerY-2.5
            D2.height=D2.height-1
            D2.width=D2.width-0.25
            D1.centerY=D2.centerY
            D1.height=D1.height-0.1
            D1.width=D1.width-0.05
        else:
            D2.centerY=D2.centerY+2.5
            D2.height=D2.height+1
            D2.width=D2.width+0.25
            D1.centerY=D2.centerY
            D1.height=D1.height+0.1
            D1.width=D1.width+0.05
        if D2.centerY>425:
            wood=51
        elif D2.centerY<-4:
            wood=49
            pass
    if TimerLabel.value==0:
        counter=2
        D1.visible=False
        D2.visible=False
        ScoreLabel.centerX=200
        ScoreLabel.centerY=200
        ScoreLabel.size=40
        TimerLabel.visible=False
        Sight.visible=False
        if ScoreLabel.value>100000:
            SuperLabel.visible=True
            if brick<25:
                SuperLabel.value='Incrediable'
            elif brick<50:
                SuperLabel.value='Super!!'
            elif brick<75:
                SuperLabel.value='Unbelieveable'
            elif brick==78:
                SuperLabel.value='Loser'
            else:
                SuperLabel.value='Registered Gunman'
            if wood<25:
                SuperLabel.fill='limegreen'
            elif wood<50:
                SuperLabel.fill='red'
            elif wood<75:
                SuperLabel.fill='yellow'
            elif wood==78:
                SuperLabel.font='grenze'
            else:
                SuperLabel.fill='white'
        app.stop()
    
    
    
