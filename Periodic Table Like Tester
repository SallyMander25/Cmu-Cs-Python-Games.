function infoScreenChange(){
  //finds the atomNames based on either the number or the name of the atom
  var elementName="aaa";
  for (var i=0;i<atomNames.length;i++){
    if (getNumber("atomicNumberInput")==atomicNumber[i]){
      input=i;
    }
    else if(getText("atomicNameInput")!=""){
      //set of variables converts all words to a capitalized proper variety
      elementName=getText("atomicNameInput");
      var elementChar=elementName[0];
      elementName=elementName.substring(1,elementName.length);
      elementName=elementChar.toUpperCase()+elementName.toLowerCase();
      if(elementName==atomNames[i]){
        input=i;
      }
    }
  }
  //sets all of the information for the infoScreen based on the atom selected
  if (input!=-1){
    setScreen("InfoScreen");
    setText("atomicNumberText", atomNames[input]+"'s atomic number is "+atomicNumber[input]);
    setText("elementNameText",atomNames[input]);
    setText("atomicWeightText", atomNames[input]+"'s atomic Weight is "+atomicWeights[input]);
    setImageURL("atomImage",atomImages[input]);
    setText("confirmButton","Confirm");
    var Density;
    if (atomDensity[i]>1){
