def Calculate():
    global displacement,time,velocity,velocityF,velocityI,acceleration,accelerationC,forceC,force,mass,comapreMass,momentum,kineticE,work,power,radius,finalAnswer,accelerationT
    finalAnswer=""
    #problems with all the speed calculations, fix now please
    if velocity*time!=0:
        physicMV["Displacement"]=velocity*time
    elif velocityI*time*acceleration!=0:
        physicMV["Displacement"]=(velocityI*time)+(0.5*acceleration*(time**2))
    abs(physicMV["Displacement"])
    if velocity*displacement!=0:
        physicMV["Time"]=displacement/velocity
    elif acceleration* displacement!=0:
        physicMV["Final Velocity"]=(2*acceleration*displacement)**0.5
    abs(physicMV["Time"])
    if displacement*time!=0:
        physicMV["Velocity"]=displacement/time
    elif acceleration*time!=0:
        physicMV["Velocity"]=acceleration*time
    elif velocityF*time!=0:
        physicMV["Velocity"]=(velocityF-velocityI)/time
    abs(physicMV["Velocity"])
    #problems
    if velocity*displacement!=0:
        physicMV["Acceleration"]=(velocity**2)/(displacement*2)
    elif force*mass!=0:
        physicMV["Acceleration"]=force/mass
    abs(physicMV["Acceleration"])
    if force*acceleration!=0:
        physicMV["Mass"]=force/acceleration
    if velocityF*mass!=0:
        physicMV["Force"]=velocityF*mass
    elif acceleration*mass!=0:
        physicMV["Force"]=mass*acceleration
    # problems
    if time!=0 and accelerationT==0: 
        physicMV["Acceleration Time"]=float(time**2)
    if mass*velocity!=0:
        physicMV["Momentum"]=mass*velocity
    elif time!=0:
        physicMV["Momentum"]=time
    if velocity*radius!=0:
        physicMV["Centripetal Acceleration"]=(velocity**2)/radius
    elif forceC*mass!=0:
        physicMV["Centripetal Acceleration"]=forceC/mass
    if mass*accelerationC!=0:
        physicMV["Centripetal Force"]=mass*accelerationC
    if mass*velocity!=0:
        physicMV["Kinetic Energy"]=0.5*mass*(velocity**2)
    if force*displacement!=0:
        physicMV["Work"]=force*displacement
    impulse=force
    physicList=list(physicMV.keys())
