def onMousePress(mouseX,mouseY):
    debounce=False
    global varChange
    if answerButton.visible==True and answerButton.contains(mouseX,mouseY):
        varAnswers.clear()
        debounce=True
        sleep(0.01)
        calVariables.visible=True
        answerButton.visible=False
    if calVariablesPrev.visible==True and calVariablesPrev.hits(mouseX,mouseY):
        calVariablesPrev.visible=False
        calVariables.visible=True
        debounce=True
        sleep(0.01)
    #changes screen when clicked(sleep added as debounce feature to remove unwanted variable clicking)
    for i in calVN.children:
        if i.hits(mouseX,mouseY) and debounce==False:
            varChange=i.value
            calVariables.visible=False
            varLabel.value=varChange
            varChanging.visible=True
        #changes the selected variable to the variable clicked
    if arrowUp.contains(mouseX,mouseY):
        exponentBox.value+=1
        pass
    if arrowDown.contains(mouseX,mouseY):
        exponentBox.value-=1
    exponent.value=exponentBox.value
    # increases or decreases the exponent amount on arrow click
